# Claude API Configuration
# Get your API key from: https://console.anthropic.com/
REACT_APP_CLAUDE_API_KEY=your_claude_api_key_here

# API Server Configuration
# Leave empty to use current domain in production, localhost:8000 in development
REACT_APP_API_URL=

# Active season configuration
# Set this to the new Sleeper league ID when the 2026 league is created.
REACT_APP_2026_LEAGUE_ID=1354521952483573760

# MCP Server Configuration (for backend services)
# URL where your MCP server is running
MCP_SERVER_URL=http://localhost:8000

# Matchup voting (backend only)
# Mount a Railway volume at /data to keep vote totals across deployments.
POLL_DATABASE_PATH=/data/amberwood_votes.db
POLL_HASH_SALT=replace_with_a_long_random_value

# Development/Production Environment
NODE_ENV=development

# Instructions:
# 1. Copy this file to .env
# 2. Replace 'your_claude_api_key_here' with your actual Claude API key
# 3. Update other URLs as needed for your deployment
